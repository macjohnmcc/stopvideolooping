{
  "manifest_version": 3,
  "name": "Stop Video Looping",
  "version": "1.2.0",
  "description": "Stops Instagram and Threads videos, plus YouTube Shorts, from replaying on repeat.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.threads.com/*",
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_title": "Stop Video Looping",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.threads.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["src/player-ui.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}